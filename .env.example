APP_NAME="CrediSure Dashboard API"
DEBUG=false
ENVIRONMENT=development

# SQLite (default)
DATABASE_URL=sqlite:///./credisure.db

# PostgreSQL (optional; install psycopg[binary])
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/credisure_db

# MySQL (optional; install PyMySQL)
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/credisure_db

SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo seeding is refused in production unless explicitly enabled.
ALLOW_DEMO_SEEDING=false
# DEMO_USER_PASSWORD=

# Optional non-interactive administrator provisioning.
# Set all three values together; never commit real credentials.
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=